{
  "name": "wayfare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wayfare: an accessible, iPhone-first trip itinerary PWA that builds trips from your Gmail booking emails.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute wayfare --remote --file=worker/schema.sql",
    "db:init:local": "wrangler d1 execute wayfare --local --file=worker/schema.sql",
    "vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
